# Número de WhatsApp en formato internacional, sin "+" ni espacios
NEXT_PUBLIC_WHATSAPP_NUMBER=5491172634803

# ID de medición de Google Analytics 4 (ej. G-XXXXXXXXXX). Si está vacío, GA no se carga.
NEXT_PUBLIC_GA_ID=

# ---- Blog y panel /admin ----
# Supabase → Project Settings → API Keys (y Data API para la URL).
# Si tu proyecto muestra las claves viejas, usá "anon" como PUBLISHABLE y "service_role" como SECRET.
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Login del panel. La contraseña: larga y que no uses en otro lado.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Clave para firmar la sesión. Generala con: openssl rand -base64 32
AUTH_SECRET=

# ---- Avisos por mail de las consultas (opcional) ----
# Con solo SMTP_PASS (la contraseña de contacto@) alcanza: el resto usa Hostinger por defecto.
SMTP_PASS=
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_USER=contacto@lupaserviciosdigitales.com
# CONSULTAS_AVISO_A=contacto@lupaserviciosdigitales.com
